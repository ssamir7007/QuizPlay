{
  "framework": "vite",
  "buildCommand": "tsc --noEmit && vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/summarize-notes.js": { "maxDuration": 150 },
    "api/generate-hangman.js": {
      "maxDuration": 180,
      "includeFiles": "src/{services/hangmanQuestions.ts,data/hangmanSample.json}"
    },
    "api/generate-quiz.js": {
      "maxDuration": 180,
      "includeFiles": "src/services/questions.ts"
    }
  }
}
